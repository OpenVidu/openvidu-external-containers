# Centralized image versions used by CI/release workflows.
#
# Renovate keeps these values up to date (see renovate.json): each
# "# renovate:" comment says where to look for new releases of the variable on
# the next line. A *_DIGEST or *_COMMIT line right after it is pinned to that
# version and updated together with it.
#
# The -rN suffix of published tags is not stored here: the build workflow
# picks the next free revision on Docker Hub.

# openvidu/grafana-loki
# renovate: datasource=docker depName=grafana/loki versioning=docker
LOKI_TAG=3.7.9
LOKI_DIGEST=sha256:0db216b630ae1f348a1584c67f3cead8b4c1fc839169a39501db664744158e28

# openvidu/minio
# MinIO tags are dates, so the year is read as "minor" to keep updates out of
# the major (manual) lane.
# renovate: datasource=github-releases depName=chainguard-forks/minio versioning=regex:^RELEASE\.(?<minor>\d{4})-(?<patch>\d{2})-(?<build>\d{2})T(?<revision>\d{2})-\d{2}-\d{2}Z$
MINIO_TAG=RELEASE.2026-11-09T00-10-40Z

# openvidu/grafana-mimir
# renovate: datasource=docker depName=grafana/mimir versioning=docker
MIMIR_TAG=3.2.4
MIMIR_DIGEST=sha256:e4ff85d922c7c0a5131576d2659a1b98b3abfd73c92448dccf8ad3a6049a7ed8

# openvidu/mongodb
# Renovate only proposes MONGODB_VERSION updates within MONGODB_MAJOR_MINOR
# (see renovate.json). Moving to a new release series is a manual change of
# both values.
MONGODB_MAJOR_MINOR=8.0
# renovate: datasource=docker depName=mongo versioning=docker
MONGODB_VERSION=8.0.34
# renovate: datasource=npm depName=mongosh versioning=npm
MONGOSH_VERSION=2.14.1

# Build-time tools used by images/mongo
# renovate: datasource=github-releases depName=mikefarah/yq versioning=semver
YQ_VERSION=v4.54.3
# renovate: datasource=github-tags depName=bitnami/wait-for-port versioning=semver
WAIT_FOR_PORT_VERSION=v1.0.11
WAIT_FOR_PORT_COMMIT=7874547cb49ec88b92a5fbf3dfee28bd6694cfc4
# renovate: datasource=github-tags depName=bitnami/render-template versioning=semver
RENDER_TEMPLATE_VERSION=v1.0.10
RENDER_TEMPLATE_COMMIT=bc9a6df0be359c708fdc675c7e2d3e5a92a4ab40
